{
  "name": "404-escape",
  "version": "1.0.0",
  "description": "Application desktop Electron de création et résolution de labyrinthes en pixel art",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.0.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.ynov.404escape",
    "productName": "404 Escape",
    "files": [
      "main.js",
      "preload.js",
      "auth.js",
      "database.js",
      "labyrinth.js",
      "admin.js",
      "renderer/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}